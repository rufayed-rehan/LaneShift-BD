{
  "info": {
    "name": "LaneShift BD Traffic Digital Twin API",
    "description": "Database-centered traffic simulation and automated reversible-lane optimization requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "runId", "value": "1" },
    { "key": "suggestionId", "value": "1" }
  ],
  "item": [
    {
      "name": "Project health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Simulation scenarios",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/simulation/scenarios" }
    },
    {
      "name": "Run morning traffic experiment",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scenario_code\": \"morning_peak\",\n  \"segment_id\": 1,\n  \"seed\": 4410\n}"
        },
        "url": "{{baseUrl}}/api/simulation/runs"
      }
    },
    {
      "name": "Simulation run history",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/simulation/runs?limit=20" }
    },
    {
      "name": "Simulation run detail",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/simulation/runs/{{runId}}" }
    },
    {
      "name": "Record safety override",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operator\": \"postman.supervisor\",\n  \"reason\": \"Demonstration safety override\"\n}"
        },
        "url": "{{baseUrl}}/api/simulation/runs/{{runId}}/override"
      }
    },
    {
      "name": "Database evidence",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/database/evidence" }
    },
    {
      "name": "Dashboard summary",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/dashboard/summary" }
    },
    {
      "name": "All road segments",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/segments" }
    },
    {
      "name": "Legacy pending suggestions",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/suggestions?status=pending" }
    },
    {
      "name": "Legacy approve suggestion",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"approved_by\": \"postman.operator\"\n}"
        },
        "url": "{{baseUrl}}/api/suggestions/{{suggestionId}}/approve"
      }
    }
  ]
}
